# Backend API URL (PRODUCTION)
# This should point to your deployed backend API
VITE_API_URL=https://your-backend-domain.com

# Supabase Configuration (Frontend)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# Note: Only use ANON key in frontend, never service role key!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Stripe Publishable Key (PRODUCTION)
# Get from: https://dashboard.stripe.com/apikeys
# Note: This is safe to expose in frontend code
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_live_stripe_publishable_key_here

