# Server Configuration
PORT=3000
NODE_ENV=production

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Fal.ai API Configuration
# Get your API key from: https://fal.ai/dashboard
FAL_API_KEY=your_fal_api_key_here

# Stripe Configuration (PRODUCTION KEYS!)
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_live_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_your_live_stripe_publishable_key_here

# Stripe Webhook Secret (PRODUCTION)
# Get this from: https://dashboard.stripe.com/webhooks
# After creating a webhook endpoint pointing to: https://your-domain.com/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret_here

# Frontend URL (PRODUCTION)
# This is your deployed frontend URL (e.g., https://decordesign.com)
FRONTEND_URL=https://your-frontend-domain.com

# Optional: Email service (for future use)
# EMAIL_SERVICE=sendgrid
# EMAIL_API_KEY=your_email_api_key
# EMAIL_FROM=noreply@your-domain.com
